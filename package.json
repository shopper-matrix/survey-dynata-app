{
  "name": "survey-dynata-app",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "pnpm db:generate && eslint .",
    "lint:fix": "pnpm db:generate && eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "pnpm db:generate && pnpm -r typecheck",
    "test": "pnpm db:generate && pnpm -r test",
    "build": "pnpm -r build",
    "db:generate": "pnpm --filter @survey-dynata/api db:generate",
    "db:migrate": "pnpm --filter @survey-dynata/api db:migrate",
    "db:deploy": "pnpm --filter @survey-dynata/api db:deploy"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
