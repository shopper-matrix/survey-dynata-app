{
  "name": "@survey-dynata/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && node build.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude \"**/*.db.test.ts\"",
    "test:db": "vitest run .db.test --no-file-parallelism --test-timeout=15000",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:validate": "prisma validate",
    "db:seed": "prisma db seed",
    "survey:import": "tsx src/survey-import/cli.ts",
    "admin:create": "tsx src/admin/cli.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/rate-limit": "^11.2.2",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "~7.10.1",
    "@prisma/client": "~7.10.1",
    "@survey-dynata/shared": "workspace:*",
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "prisma": "~7.10.1",
    "sav-reader": "^2.0.8",
    "tsx": "^4.23.15"
  }
}
