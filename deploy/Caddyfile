# Web container of one app stack: serves the built frontend over plain HTTP inside the server.
# HTTPS and routing are done by the edge proxy (deploy/edge).
{
	auto_https off
	admin off
}

:80 {
	# Its CSP comes as a meta tag from the build; frame-ancestors can only be sent as a header
	# (DSA-503).
	header {
		Strict-Transport-Security "max-age=31536000"
		Content-Security-Policy "frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
	root * /srv
	try_files {path} /index.html
	file_server
}
