# Production images, built from the repo root (see deploy/README.md).
# Stage "build" installs and builds everything. Target "api" applies pending migrations, then
# starts the API. Target "web" is Caddy serving the built frontend and proxying API routes.
FROM node:26-alpine AS build
RUN npm install -g pnpm@12.18.0
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile && pnpm build

FROM build AS api
ENV NODE_ENV=production
EXPOSE 3000
CMD ["sh", "-c", "pnpm db:deploy && node apps/api/dist/server.js"]

FROM caddy:2-alpine AS web
COPY --from=build /app/apps/web/dist /srv
