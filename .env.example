# Environment variables for local development.
#
#   cp .env.example .env      (PowerShell: Copy-Item .env.example .env)
#
# Then replace the placeholder values. `.env` is git-ignored: never commit real secrets.
# Docker Compose reads `.env` automatically; the API validates its variables at startup and
# refuses to start if one is missing or invalid (apps/api/src/env.ts).

# ---------------------------------------------------------------------------
# PostgreSQL (Docker Compose `db` service)
# ---------------------------------------------------------------------------

# Database user created on first start of the database volume.
POSTGRES_USER=survey
# Password for POSTGRES_USER. Required. Use letters/digits only (it is embedded in a URL).
# Only applied when the volume is first created; after changing it run `docker compose down -v`.
POSTGRES_PASSWORD=change-me
# Name of the application database.
POSTGRES_DB=survey_dynata

# ---------------------------------------------------------------------------
# API (apps/api)
# ---------------------------------------------------------------------------

# Postgres connection string. Required by the API.
# Used when running the API outside Docker; inside Docker Compose it is built from the
# POSTGRES_* values above with host `db`.
DATABASE_URL=postgres://survey:change-me@localhost:5432/survey_dynata
# Port the API listens on inside its container / on your machine. Default: 3000.
PORT=3000
# development | test | production. Default: development.
NODE_ENV=development
# Public address respondents use (no trailing slash). Survey entry links given to Dynata are
# <APP_BASE_URL>/s/<surveyId>. In development this is the web dev server, which forwards
# /s/… and /mock-dynata/… to the API, so entry, session cookie and survey share one address.
# Required.
APP_BASE_URL=http://localhost:5173
# Signs the respondent session cookie. At least 32 random characters; generate one with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Required. Use a different value in every environment and never commit a real one.
SESSION_SECRET=replace-me-with-at-least-32-random-characters
# Cloudflare Turnstile bot check on the welcome screen. Leave empty to switch it off (local
# development). Cloudflare test keys that always pass: site 1x00000000000000000000AA,
# secret 1x0000000000000000000000000000000AA. Real keys: Cloudflare dashboard > Turnstile.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Admin dashboard sessions end after this many minutes without activity. Default: 30.
ADMIN_SESSION_IDLE_MINUTES=30

# ---------------------------------------------------------------------------
# Dynata (apps/api/src/dynata, docs/dynata-integration.md)
# ---------------------------------------------------------------------------

# mock: entry links are verified locally and end links point at local test pages, no Dynata
# account needed. live: Dynata's Signed URL API is used. Default: mock.
DYNATA_MODE=mock
# Key ID and secret issued by Dynata (one pair per client). Required when DYNATA_MODE=live.
# Never commit real values: keep them in .env locally and in the hosting secret store.
DYNATA_KEY_ID=
DYNATA_SECRET=
# Dynata's buildAndValidate endpoint. Default: https://passphrase.dynata.com/v1/links/buildAndValidate
DYNATA_API_URL=

# ---------------------------------------------------------------------------
# Host ports published by Docker Compose (change if a port is already in use)
# ---------------------------------------------------------------------------

# Web app: http://localhost:<WEB_PORT>. Default: 5173.
WEB_PORT=5173
# API: http://localhost:<API_PORT>. Default: 3000.
API_PORT=3000
# PostgreSQL on localhost:<POSTGRES_PORT>. Default: 5432.
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Dev-server settings (already set by compose.yaml; only needed outside Docker)
# ---------------------------------------------------------------------------

# Where the web dev server proxies /api requests. Default: http://localhost:3000.
API_PROXY_TARGET=http://localhost:3000
# true = poll for file changes (needed for hot reload in Docker on Windows/macOS). Default: false.
VITE_USE_POLLING=false
# Same as VITE_USE_POLLING, for the API's `tsx watch`. Default: false.
CHOKIDAR_USEPOLLING=false
